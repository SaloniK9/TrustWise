# Dockerfile for Celery Workers and Beat Scheduler
# Used for distributed task execution with Celery + Redis

FROM python:3.14-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    libpq-dev \
    curl \
    libxml2-dev \
    libxslt1-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir celery[redis]==5.3.4 && \
    pip install --no-cache-dir flower==2.0.1

# Copy application code
COPY . .

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "from app.celery_config import app; app.control.inspect().active()" || exit 1

# Default command (override in docker-compose)
CMD ["celery", "-A", "app.tasks", "worker", "-l", "info"]
